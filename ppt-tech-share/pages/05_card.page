    elementId: stat1-d
    elementType: text
  - bounds: [360, 140, 240, 44]
    content:
      style: $monobig
      fontSize: 30
      text: 6 阶段
      wrap: false
    elementId: stat2
    elementType: text
  - bounds: [360, 190, 260, 44]
    content:
      style: $small
      text: 确定性流水线：分拣 → 提取 → 解析 → 校验 → 比价 → 导出
    elementId: stat2-d
    elementType: text
  - bounds: [656, 140, 240, 44]
