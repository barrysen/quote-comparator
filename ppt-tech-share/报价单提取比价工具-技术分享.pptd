version: v2
title: 报价单提取比价工具 · 技术分享
size:
  - 960
  - 540
theme:
  colors:
    green: '#17705F'
    ink: '#1A1D21'
    gray: '#6E747C'
    orange: '#D96C2C'
    paper: '#FCFCFA'
    beige: '#F1EFE8'
    line: '#E4E2DA'
    dark: '#1A1D21'
    dmuted: '#A6ADB5'
    dchip: '#3A3F45'
    dtext: '#C9CDD2'
    cellgreen: '#C6EFCE'
    cellred: '#FFC7CE'
    cellorange: '#FFE0B2'
    cellyellow: '#FFF3CD'
    cellgray: '#D9D9D9'
  textStyles:
    kicker:
      color: $green
      fontFamily: JetBrains Mono, JetBrains Mono
      fontSize: 11
      bold: true
      letterSpacing: 3
    title:
      color: $ink
      fontFamily: MiSans, MiSans
      fontSize: 26
      bold: true
    body:
      color: $ink
      fontFamily: MiSans, MiSans
      fontSize: 13
      lineHeight: 1.7
    small:
      color: $gray
      fontFamily: MiSans, MiSans
      fontSize: 12
      lineHeight: 1.6
    mono:
      color: $gray
      fontFamily: JetBrains Mono, JetBrains Mono
      fontSize: 11
      lineHeight: 1.6
    monobig:
      color: $green
      fontFamily: JetBrains Mono, JetBrains Mono
      fontSize: 26
      lineHeight: 1.6
    dkicker:
      color: $orange
      fontFamily: JetBrains Mono, JetBrains Mono
      fontSize: 13
      letterSpacing: 3
      lineHeight: 1.6
    dtitle:
      color: '#FFFFFF'
      fontFamily: MiSans, MiSans
      fontSize: 40
      bold: true
    dsub:
      color: $dmuted
      fontFamily: MiSans, MiSans
      fontSize: 15
    dchip:
      color: $dtext
      fontFamily: JetBrains Mono, JetBrains Mono
      fontSize: 14
      lineHeight: 1.6
  tableStyles:
    plain:
      cellStyle:
        align:
          - left
          - middle
        color: $ink
        fontFamily: MiSans, MiSans
        fontSize: 12
        border:
          - null
          - null
          - color: $line
            style: solid
            width: 1
          - null
      firstRowStyle:
        bold: true
        color: $gray
        fontSize: 11
        border:
          - null
          - null
          - color: $ink
            style: solid
            width: 1
          - null
      rowOverColumn: true
    mono:
      cellStyle:
        align:
          - left
          - middle
        color: $ink
        fontFamily: MiSans, MiSans
        fontSize: 12
        border:
          - null
          - null
          - color: $line
            style: solid
            width: 1
          - null
      firstColumnStyle:
        bold: true
        color: $green
        fontFamily: JetBrains Mono, JetBrains Mono
        fontSize: 12
      firstRowStyle:
        bold: true
        color: $gray
        fontSize: 11
        border:
          - null
          - null
          - color: $ink
            style: solid
            width: 1
          - null
      rowOverColumn: true
pages:
  - pages/01_cover.page
  - pages/02_why.page
  - pages/03_toc.page
  - pages/04_part1.page
  - pages/05_card.page
  - pages/06_goals.page
  - pages/07_part2.page
  - pages/08_pipeline.page
  - pages/09_stage12.page
  - pages/10_stage3.page
  - pages/11_stage4.page
  - pages/12_stage5.page
  - pages/13_stage6.page
  - pages/14_part3.page
  - pages/15_llm.page
  - pages/16_h1.page
  - pages/17_part4.page
  - pages/18_code.page
  - pages/19_run.page
  - pages/20_final.page
