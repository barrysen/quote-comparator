version: v2
theme:
    colors:
        accent1: '#4472C4'
        accent2: '#ED7D31'
        accent3: '#A5A5A5'
        accent4: '#FFC000'
        accent5: '#5B9BD5'
        accent6: '#70AD47'
        dk1: '#000000'
        dk2: '#1F2937'
        folHlink: '#954F72'
        hlink: '#0563C1'
        lt1: '#FFFFFF'
        lt2: '#F3F4F6'
    tableStyles:
        table1:
            cellStyle:
                align:
                    - left
                    - middle
            firstColumnStyle:
                bold: true
                border:
                    - null
                    - null
                    - color: '#E4E2DA'
                      style: solid
                      width: 1
                    - null
                color: '#17705F'
                fontFamily: JetBrains Mono, JetBrains Mono
                fontSize: 12
            firstRowStyle:
                bold: true
                border:
                    - null
                    - null
                    - color: '#1A1D21'
                      style: solid
                      width: 1
                    - null
                color: '#6E747C'
                fontSize: 11
            rowOverColumn: true
    textStyles:
